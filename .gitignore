# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
.venv/

# Environment
.env
**/settings_local.yaml
credentials*.yaml

# 工具缓存（二进制，单机可重生成；.mypy_cache 达 20 MiB，误提交进库无法有效 diff）
.mypy_cache/
.ruff_cache/
.pytest_cache/
.screenshots/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Reports / outputs（只跟踪治理文档 reports/README.md；实验产物不进 git）
reports/*
!reports/README.md
output/

# Logs
*.log
# 一次性诊断输出（非日志）：stale panel 清单 / probe 摘要
logs/*.txt
logs/*.lst
# 后台跑批的 stdout 落盘（logs 是本地运行目录，不进版本库）
logs/*.out
# 临时落盘的中间件：旧 registry 快照 / selection 对照 JSON（一次诊断用完即弃）
logs/*.csv
logs/*.json

# SDK cache (user-specific)
AmazingData/
AmazingData开发手册.pdf

# Local workspace data
.workbuddy/
_real_out.txt

# Root scratch scripts (one-off checks, memory dumps)
/_*.py

# 一次性脚本（不入库，用完即删、定期清理；2026-11-20 定）
scripts/oneoff/

# Local data caches (SDK pulls / GFlowNet checkpoints, regenerable)
.cache_p2/
.gflow_cache*/
.sdk_cache*/
.tmp_*/

# Trained model artifacts (large binaries)
/models/

# Factor library data panels (regenerable from scripts)
/hs300_2025/

# Deliverable plan package (like reports/, one-off output)
etf-rotation-plan/

# IDE share packages
.trae-html-share-packages/
.test-tmp/

# Agent session plans (local IDE state)
.zcode/

# One-off scratch dirs created by ad-hoc commands
reports/.pytest_tmp*/
/_tmp/

# OS
Thumbs.db
.DS_Store

# 依赖锁：本地保留、不入库（2026-10-27 移出跟踪，工作流用系统解释器）
uv.lock
